{
  "$schema": "http://json-schema.org/draft/2020-12/schema",
  "$id": "https://rig.dev/schemas/rig-workflow-chain.schema.json",
  "title": "Rig Workflow Chain Schema",
  "description": "JSON Schema for Rig workflow chain domain types. Validates WorkflowContext, WorkflowCommand, WorkflowCommandResult, and WorkflowRunResult structures.",
  "type": "object",
  "definitions": {
    "WorkflowCommand": {
      "type": "object",
      "description": "A single command in a workflow chain.",
      "additionalProperties": false,
      "required": ["id", "command"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this command within a context",
          "minLength": 1,
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
        },
        "command": {
          "type": "array",
          "description": "Command as array of arguments (NEVER a shell string).",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": {
          "type": "boolean",
          "description": "If true, failure blocks the entire workflow.",
          "default": true
        },
        "mutates_state": {
          "type": "boolean",
          "description": "If true, command modifies state (agent-restricted).",
          "default": false
        },
        "agent_allowed": {
          "type": "boolean",
          "description": "If true, agents may execute this command.",
          "default": true
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of what this command does.",
          "default": ""
        }
      }
    },
    "WorkflowContext": {
      "type": "object",
      "description": "A workflow context containing a chain of commands.",
      "additionalProperties": false,
      "required": ["id", "description", "commands"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique context identifier (e.g., 'mission_handoff', 'promotion_dry_run').",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of this context's purpose.",
          "minLength": 1
        },
        "agent_allowed": {
          "type": "boolean",
          "description": "If true, agents may run this entire context.",
          "default": true
        },
        "mutates_state": {
          "type": "boolean",
          "description": "If true, context contains state-mutating commands.",
          "default": false
        },
        "commands": {
          "type": "array",
          "description": "Tuple of WorkflowCommand objects to execute in order.",
          "default": [],
          "items": {
            "$ref": "#/definitions/WorkflowCommand"
          }
        }
      }
    },
    "WorkflowCommandResult": {
      "type": "object",
      "description": "Result of executing a single workflow command.",
      "additionalProperties": false,
      "required": ["id", "command", "returncode", "passed", "required"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Command identifier.",
          "minLength": 1
        },
        "command": {
          "type": "array",
          "description": "The command that was executed (as array).",
          "items": {
            "type": "string"
          }
        },
        "returncode": {
          "type": "integer",
          "description": "Process exit code (0 = success)."
        },
        "stdout": {
          "type": "string",
          "description": "Captured stdout (truncated to MAX_OUTPUT_CHARS).",
          "default": ""
        },
        "stderr": {
          "type": "string",
          "description": "Captured stderr (truncated to MAX_OUTPUT_CHARS).",
          "default": ""
        },
        "passed": {
          "type": "boolean",
          "description": "True if returncode == 0."
        },
        "required": {
          "type": "boolean",
          "description": "Whether this command was required."
        }
      }
    },
    "WorkflowRunResult": {
      "type": "object",
      "description": "Result of running a complete workflow context.",
      "additionalProperties": false,
      "required": ["context_id", "passed", "results", "blockers"],
      "properties": {
        "context_id": {
          "type": "string",
          "description": "ID of the workflow context that was run.",
          "minLength": 1
        },
        "passed": {
          "type": "boolean",
          "description": "True if all required commands passed."
        },
        "results": {
          "type": "array",
          "description": "Tuple of WorkflowCommandResult for each executed command.",
          "default": [],
          "items": {
            "$ref": "#/definitions/WorkflowCommandResult"
          }
        },
        "blockers": {
          "type": "array",
          "description": "Tuple of blocker message strings.",
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_path": {
          "type": ["string", "null"],
          "description": "Path to evidence file, or null if not written.",
          "default": null
        },
        "timestamp": {
          "type": "string",
          "description": "ISO 8601 timestamp of when the workflow was run.",
          "pattern": "^[0-9]{8}T[0-9]{6}Z$"
        }
      }
    },
    "WorkflowEvidence": {
      "type": "object",
      "description": "Evidence written to disk for a workflow run.",
      "additionalProperties": false,
      "required": ["context_id", "passed", "timestamp", "results", "blockers"],
      "properties": {
        "context_id": {
          "$ref": "#/definitions/WorkflowRunResult/properties/context_id"
        },
        "passed": {
          "$ref": "#/definitions/WorkflowRunResult/properties/passed"
        },
        "timestamp": {
          "$ref": "#/definitions/WorkflowRunResult/properties/timestamp"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "command", "returncode", "passed", "required"],
            "properties": {
              "id": {"type": "string"},
              "command": {
                "type": "array",
                "items": {"type": "string"}
              },
              "returncode": {"type": "integer"},
              "passed": {"type": "boolean"},
              "required": {"type": "boolean"},
              "stdout": {"type": "string", "default": ""},
              "stderr": {"type": "string", "default": ""}
            }
          }
        },
        "blockers": {
          "$ref": "#/definitions/WorkflowRunResult/properties/blockers"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/definitions/WorkflowContext"
    },
    {
      "$ref": "#/definitions/WorkflowCommand"
    },
    {
      "$ref": "#/definitions/WorkflowCommandResult"
    },
    {
      "$ref": "#/definitions/WorkflowRunResult"
    },
    {
      "$ref": "#/definitions/WorkflowEvidence"
    }
  ]
}
