{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rig Local Patch Validation",
  "type": "object",
  "required": [
    "schema_version",
    "patch_id",
    "task",
    "status",
    "repair_loop_used",
    "repair_attempt_count",
    "max_repair_attempts",
    "successful_attempt",
    "attempts",
    "final_failure_reason",
    "git_apply_check_status",
    "sandbox_apply_status",
    "scope_status",
    "forbidden_path_violations",
    "binary_patch_detected",
    "deletion_detected",
    "validation_commands",
    "artifacts",
    "warnings",
    "authoritative"
  ],
  "properties": {
    "schema_version": { "const": "rig.patch_validation.v1" },
    "patch_id": { "type": "string" },
    "task": { "type": "string" },
    "status": { "enum": ["proposed", "check_passed", "check_failed", "sandbox_applied", "validation_passed", "validation_failed", "rejected"] },
    "repair_loop_used": { "type": "boolean" },
    "repair_attempt_count": { "type": "integer" },
    "max_repair_attempts": { "type": "integer" },
    "successful_attempt": { "type": ["integer", "null"] },
    "attempts": { "type": "array" },
    "final_failure_reason": { "type": ["string", "null"] },
    "git_apply_check_status": { "type": "string" },
    "sandbox_apply_status": { "type": "string" },
    "scope_status": { "type": "string" },
    "forbidden_path_violations": { "type": "array", "items": { "type": "string" } },
    "binary_patch_detected": { "type": "boolean" },
    "deletion_detected": { "type": "boolean" },
    "validation_commands": { "type": "array" },
    "artifacts": { "type": "array", "items": { "type": ["string", "null"] } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "authoritative": { "const": false }
  }
}
