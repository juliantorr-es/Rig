{
  "$id": "https://rig.anigma.internal/schemas/rig.workspace.v1.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rig Workspace Configuration Schema",
  "description": "Schema for Rig workspace metadata.",
  "type": "object",
  "properties": {
    "workspace_id": { "type": "string" },
    "repo_root": { "type": "string" },
    "task": { "type": "string" },
    "mode": { "type": "string", "enum": ["safe", "action", "auto_approve"] },
    "status": { "type": "string" },
    "worktree": { "type": ["object", "null"] },
    "receipt_paths": { "type": "array", "items": { "type": "string" } },
    "authoritative": { "type": "boolean" }
  },
  "required": ["workspace_id", "repo_root", "task", "status", "authoritative"]
}
