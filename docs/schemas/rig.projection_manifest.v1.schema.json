{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rig.anigma.internal/schemas/rig.projection_manifest.v1.schema.json",
  "title": "Rig Projection Manifest",
  "description": "The manifest of derived read models (projections) in the Rig OS.",
  "type": "object",
  "required": [
    "schema_version",
    "created_at",
    "status",
    "projections",
    "authoritative"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "rig.projection_manifest.v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["pass", "warn", "fail"] },
    "projections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "projection_id",
          "kind",
          "status",
          "path",
          "rebuilt_at",
          "authoritative"
        ],
        "properties": {
          "projection_id": { "type": "string" },
          "kind": { "enum": ["kanban", "task_graph", "monitor", "tui_snapshot", "prompt_lab", "agent_status", "model_status"] },
          "status": { "enum": ["pass", "warn", "fail", "skipped"] },
          "path": { "type": "string" },
          "source_count": { "type": "integer", "minimum": 0 },
          "record_count": { "type": "integer", "minimum": 0 },
          "rebuilt_at": { "type": "string", "format": "date-time" },
          "warnings": { "type": "array", "items": { "type": "string" } },
          "authoritative": { "type": "boolean", "const": false }
        }
      }
    },
    "source_artifacts": { "type": "array", "items": { "type": "string" } },
    "source_tables": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "authoritative": { "type": "boolean", "const": false }
  },
  "additionalProperties": false
}
