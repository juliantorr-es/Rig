{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rig.debug_bundle_manifest.v1",
  "title": "Rig Debug Bundle Manifest v1",
  "type": "object",
  "required": ["schema", "created_at", "repo_root", "output", "sections", "redact", "config"],
  "properties": {
    "schema": { "const": "rig.debug_bundle_manifest.v1" },
    "created_at": { "type": "string" },
    "repo_root": { "type": "string" },
    "output": { "type": "string" },
    "python_executable": { "type": "string" },
    "python_version": { "type": "string" },
    "platform": { "type": "string" },
    "sections": { "type": "array", "items": { "type": "string" } },
    "redact": { "type": "boolean" },
    "config": { "type": "object" }
  },
  "additionalProperties": true
}
