{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rig.proposal_swarm.v1",
  "title": "Rig Proposal Swarm v1",
  "type": "object",
  "required": [
    "schema_version",
    "swarm_id",
    "task",
    "kind",
    "created_at",
    "backend",
    "profile",
    "candidate_count",
    "max_parallel",
    "effective_context_per_candidate",
    "context_pack_path",
    "status",
    "candidates",
    "winner_candidate_id",
    "scoreboard_path",
    "warnings",
    "authoritative"
  ],
  "properties": {
    "schema_version": {"const": "rig.proposal_swarm.v1"},
    "swarm_id": {"type": "string"},
    "task": {"type": "string"},
    "kind": {"type": "string", "enum": ["plan", "validator_error_classification", "docs_normalization_plan", "patch_proposal", "prompt_repair"]},
    "created_at": {"type": "string"},
    "backend": {"type": "string"},
    "model": {"type": ["string", "null"]},
    "profile": {"type": "string"},
    "candidate_count": {"type": "integer", "minimum": 1},
    "max_parallel": {"type": "integer", "minimum": 1},
    "effective_context_per_candidate": {"type": "integer", "minimum": 1},
    "context_pack_path": {"type": ["string", "null"]},
    "status": {"type": "string", "enum": ["planned", "running", "passed", "failed", "blocked", "dry_run"]},
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    },
    "winner_candidate_id": {"type": ["string", "null"]},
    "scoreboard_path": {"type": ["string", "null"]},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "authoritative": {"const": true}
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "required": [
        "schema_version",
        "swarm_id",
        "candidate_id",
        "task",
        "kind",
        "strategy",
        "prompt_path",
        "raw_output_path",
        "parsed_output_path",
        "validation_path",
        "score_path",
        "status",
        "score",
        "authoritative"
      ],
      "properties": {
        "schema_version": {"const": "rig.proposal_candidate.v1"},
        "swarm_id": {"type": "string"},
        "candidate_id": {"type": "string"},
        "task": {"type": "string"},
        "kind": {"type": "string"},
        "strategy": {"type": "string"},
        "prompt_path": {"type": ["string", "null"]},
        "raw_output_path": {"type": ["string", "null"]},
        "parsed_output_path": {"type": ["string", "null"]},
        "validation_path": {"type": ["string", "null"]},
        "score_path": {"type": ["string", "null"]},
        "status": {"type": "string", "enum": ["planned", "running", "passed", "failed", "quarantined"]},
        "score": {"type": "number"},
        "failure_type": {"type": ["string", "null"]},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "authoritative": {"const": false}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
