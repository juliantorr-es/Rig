{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anigma.io/schemas/rig.project_blueprint.v1.schema.json",
  "title": "Rig Project Blueprint",
  "description": "A plan for initializing a new Rig project structure",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "blueprint_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "repo_root": { "type": "string" },
    "project_name": { "type": "string" },
    "project_kind": { "type": "string" },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "user_goal": { "type": "string" },
    "intended_audience": { "type": "string" },
    "usage_model": { "type": "string" },
    "publish_intent": { "type": "boolean" },
    "recommended_profile": { "type": "string" },
    "selected_adapters": { "type": "array", "items": { "type": "string" } },
    "would_create": { "type": "array", "items": { "type": "string" } },
    "would_modify": { "type": "array", "items": { "type": "string" } },
    "would_skip": { "type": "array", "items": { "type": "string" } },
    "generated_files": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "recommended_validators": { "type": "array", "items": { "type": "string" } },
    "recommended_first_tasks": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "authoritative": { "type": "boolean", "const": true }
  },
  "required": ["schema_version", "blueprint_id", "created_at", "repo_root", "project_kind", "authoritative"]
}
