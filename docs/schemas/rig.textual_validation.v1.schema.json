{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rig Textual Validation Result",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "const": "rig.textual_validation.v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["pass", "fail"] },
    "checked_paths": { "type": "array", "items": { "type": "string" } },
    "issue_count": { "type": "integer" },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "severity": { "type": "string", "enum": ["error", "warning"] },
          "path": { "type": "string" },
          "line": { "type": "integer" },
          "column": { "type": "integer" },
          "snippet": { "type": "string" },
          "message": { "type": "string" },
          "why_it_fails": { "type": "string" },
          "fix": { "type": "string" },
          "correct_example": { "type": "string" },
          "source": { "type": "string", "const": "rig_textual_validator" }
        },
        "required": ["code", "severity", "path", "line", "message", "fix"]
      }
    },
    "warnings": { "type": "array", "items": { "$ref": "#/properties/issues/items" } },
    "agent_repair_prompt": { "type": "string" },
    "authoritative": { "type": "boolean", "const": true }
  },
  "required": ["schema_version", "status", "issue_count", "issues", "warnings"]
}
