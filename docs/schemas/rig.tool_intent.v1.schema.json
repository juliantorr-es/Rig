{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anigma.io/schemas/rig.tool_intent.v1.schema.json",
  "title": "Rig Tool Intent",
  "description": "Model-generated proposal for a Rig operation",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "intent_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "source": { "type": "string" },
    "task": { "type": "string" },
    "intent_kind": {
      "type": "string",
      "enum": ["run_action", "create_plan", "validate_artifact", "inspect_receipt", "open_view"]
    },
    "requested_action": { "type": "string" },
    "requested_args": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean", "null", "array", "object"] }
    },
    "requested_paths": { "type": "array", "items": { "type": "string" } },
    "requested_mode": { "type": "string" },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "rationale": { "type": "string" },
    "authoritative": { "type": "boolean", "const": false }
  },
  "required": ["schema_version", "intent_id", "intent_kind", "authoritative"]
}
