{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rig Agent Run",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "plan_id",
    "task",
    "agent_id",
    "status",
    "exit_code",
    "started_at",
    "finished_at",
    "duration_seconds",
    "command_template_id",
    "prompt_path",
    "stdout_path",
    "stderr_path",
    "event_path",
    "artifacts",
    "warnings",
    "authoritative"
  ],
  "properties": {
    "schema_version": {"const": "rig.agent_run.v1"},
    "run_id": {"type": "string"},
    "plan_id": {"type": "string"},
    "task": {"type": ["string", "null"]},
    "agent_id": {"type": "string"},
    "status": {"type": "string"},
    "exit_code": {"type": "integer"},
    "started_at": {"type": "string"},
    "finished_at": {"type": "string"},
    "duration_seconds": {"type": "number"},
    "command_template_id": {"type": "string"},
    "prompt_path": {"type": "string"},
    "stdout_path": {"type": "string"},
    "stderr_path": {"type": "string"},
    "event_path": {"type": "string"},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "authoritative": {"type": "boolean", "const": false}
  },
  "additionalProperties": true
}
