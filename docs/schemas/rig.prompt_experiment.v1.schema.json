{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "prompt_kind",
    "baseline_template",
    "candidate_template",
    "case_count",
    "minimum_case_threshold",
    "metrics",
    "prompt_knobs_compared",
    "baseline_schema_valid_rate",
    "candidate_schema_valid_rate",
    "baseline_timeout_rate",
    "candidate_timeout_rate",
    "unsafe_regression_count",
    "promotion_blockers",
    "recommendation_reason",
    "baseline_results",
    "candidate_results",
    "regressions",
    "improvements",
    "promotion_recommendation",
    "warnings",
    "created_at",
    "authoritative"
  ],
  "properties": {
    "schema_version": { "const": "rig.prompt_experiment.v1" },
    "experiment_id": { "type": "string" },
    "prompt_kind": { "type": "string" },
    "baseline_template": { "type": "string" },
    "candidate_template": { "type": "string" },
    "case_count": { "type": "integer" },
    "minimum_case_threshold": { "type": "integer" },
    "metrics": { "type": "object" },
    "prompt_knobs_compared": { "type": "object" },
    "baseline_schema_valid_rate": { "type": "number" },
    "candidate_schema_valid_rate": { "type": "number" },
    "baseline_timeout_rate": { "type": "number" },
    "candidate_timeout_rate": { "type": "number" },
    "unsafe_regression_count": { "type": "integer" },
    "promotion_blockers": { "type": "array", "items": { "type": "string" } },
    "recommendation_reason": { "type": "string" },
    "baseline_results": { "type": "array" },
    "candidate_results": { "type": "array" },
    "regressions": { "type": "array" },
    "improvements": { "type": "array" },
    "promotion_recommendation": { "type": "string" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string" },
    "authoritative": { "const": false }
  }
}
