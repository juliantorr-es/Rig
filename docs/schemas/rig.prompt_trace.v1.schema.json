{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "trace_id",
    "prompt_kind",
    "prompt_template_id",
    "backend",
    "model",
    "runtime_settings",
    "prompt_path",
    "raw_output_path",
    "status",
    "failure_type",
    "failure_summary",
    "repair_attempted",
    "repair_success",
    "quarantined",
    "created_at",
    "authoritative"
  ],
  "properties": {
    "schema_version": { "const": "rig.prompt_trace.v1" },
    "trace_id": { "type": "string" },
    "task": { "type": ["string", "null"] },
    "prompt_kind": { "type": "string" },
    "prompt_template_id": { "type": "string" },
    "backend": { "type": "string" },
    "model": { "type": "string" },
    "model_path": { "type": ["string", "null"] },
    "model_filename": { "type": ["string", "null"] },
    "preset": { "type": ["string", "null"] },
    "n_batch": { "type": ["integer", "null"] },
    "runtime_settings": { "type": "object" },
    "context_pack_path": { "type": ["string", "null"] },
    "context_hash": { "type": ["string", "null"] },
    "prompt_path": { "type": "string" },
    "raw_output_path": { "type": "string" },
    "parsed_output_path": { "type": ["string", "null"] },
    "validator_path": { "type": ["string", "null"] },
    "validator_kind": { "type": ["string", "null"] },
    "validator_artifact": { "type": ["string", "null"] },
    "expected_contract": { "type": ["string", "null"] },
    "repair_strategy": { "type": ["string", "null"] },
    "prompt_knobs": { "type": "object" },
    "context_char_count": { "type": ["integer", "null"] },
    "model_runtime_settings": { "type": "object" },
    "top_p": { "type": ["number", "null"] },
    "top_k": { "type": ["integer", "null"] },
    "min_p": { "type": ["number", "null"] },
    "repeat_penalty": { "type": ["number", "null"] },
    "max_tokens": { "type": ["integer", "null"] },
    "stop": { "type": "array", "items": { "type": "string" } },
    "section_order": { "type": "array", "items": { "type": "string" } },
    "retry_count": { "type": ["integer", "null"] },
    "related_patch_id": { "type": ["string", "null"] },
    "related_loop_run_id": { "type": ["string", "null"] },
    "related_agent_run_id": { "type": ["string", "null"] },
    "status": { "type": "string", "enum": ["valid", "invalid", "unsafe", "timeout", "error"] },
    "failure_type": { "type": "string" },
    "quarantine_reason": { "type": ["string", "null"] },
    "failure_summary": { "type": "string" },
    "repair_attempted": { "type": "boolean" },
    "repair_success": { "type": "boolean" },
    "quarantined": { "type": "boolean" },
    "created_at": { "type": "string" },
    "authoritative": { "const": false },
    "hashes": { "type": "object" },
    "quarantine_path": { "type": ["string", "null"] },
    "quarantine_summary_path": { "type": ["string", "null"] }
  }
}
