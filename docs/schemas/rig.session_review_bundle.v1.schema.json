{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anigma.io/schemas/rig.session_review_bundle.v1.schema.json",
  "title": "Rig Session Review Bundle Manifest",
  "type": "object",
  "required": ["schema_version", "task", "created_by", "bundle_status", "included_files", "omitted_files", "sha256", "size_bytes"],
  "properties": {
    "schema_version": { "const": "rig.session_review_bundle.v1" },
    "task": { "type": "string" },
    "run_id": { "type": ["string", "null"] },
    "created_by": { "type": "string" },
    "source_repo_root": { "type": "string" },
    "bundle_status": { "type": "string", "enum": ["reviewable", "not_reviewable", "partial"] },
    "scope_status": { "type": ["string", "object", "null"] },
    "review_status": { "type": ["string", "null"] },
    "commit_plan_status": { "type": ["string", "null"] },
    "registry_gate_status": { "type": ["string", "null"] },
    "schema_status": { "type": ["string", "null"] },
    "swift_status": { "type": ["string", "null"] },
    "affected_targets": { "type": ["string", "array", "null"] },
    "recommended_profiles": { "type": ["string", "array", "null"] },
    "included_files": { "type": "array", "items": { "type": "string" } },
    "omitted_files": { "type": "array" },
    "modified_files_included": { "type": "array", "items": { "type": "string" } },
    "untracked_files_included": { "type": "array", "items": { "type": "string" } },
    "patches": { "type": "array" },
    "proofs": { "type": "array", "items": { "type": "string" } },
    "briefs": { "type": "array", "items": { "type": "string" } },
    "indexes": { "type": "array", "items": { "type": "string" } },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "sha256": { "type": ["string", "null"] },
    "size_bytes": { "type": "integer" },
    "warnings": { "type": "array" },
    "limitations": { "type": "array" }
  }
}
