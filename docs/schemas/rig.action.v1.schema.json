{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rig Action Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "action_id",
    "task",
    "action_kind",
    "command_group",
    "command",
    "inputs",
    "outputs",
    "tool_versions",
    "environment_fingerprint",
    "started_at",
    "finished_at",
    "duration_seconds",
    "status",
    "exit_code",
    "authoritative"
  ],
  "properties": {
    "schema_version": { "const": "rig.action.v1" },
    "action_id": { "type": "string" },
    "task": { "type": "string" },
    "action_kind": { "type": "string" },
    "command_group": { "type": "string" },
    "command": { "type": ["string", "array"] },
    "inputs": { "type": "array", "items": { "type": "object" } },
    "outputs": { "type": "array", "items": { "type": "object" } },
    "tool_versions": { "type": "object" },
    "environment_fingerprint": { "type": "object" },
    "started_at": { "type": "string" },
    "finished_at": { "type": "string" },
    "duration_seconds": { "type": "number" },
    "status": { "type": "string" },
    "exit_code": { "type": "integer" },
    "result_path": { "type": ["string", "null"] },
    "event_path": { "type": ["string", "null"] },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "authoritative": { "const": false }
  },
  "additionalProperties": true
}
