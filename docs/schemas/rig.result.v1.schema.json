{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rig Result",
  "type": "object",
  "required": ["schema_version", "run_id", "command_group", "command", "status", "exit_code", "artifacts", "warnings", "errors", "summary"],
  "properties": {
    "schema_version": {"type": "string", "const": "rig.result.v1"},
    "run_id": {"type": "string"},
    "command_group": {"type": "string"},
    "command": {"type": "string"},
    "task": {"type": ["string", "null"]},
    "status": {"type": "string", "enum": ["passed", "failed", "known_blocked", "skipped"]},
    "exit_code": {"type": "integer"},
    "started_at": {"type": ["string", "null"]},
    "finished_at": {"type": ["string", "null"]},
    "duration_seconds": {"type": ["number", "integer", "null"]},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"type": ["string", "object"]}},
    "errors": {"type": "array", "items": {"type": ["string", "object"]}},
    "summary": {"type": "object"},
    "next_actions": {"type": "array", "items": {"type": "string"}},
    "stderr_tail": {"type": ["string", "null"]}
  }
}
