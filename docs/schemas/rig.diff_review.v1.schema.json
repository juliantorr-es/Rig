{
  "$id": "https://rig.anigma.internal/schemas/rig.diff_review.v1.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rig Diff Review Schema",
  "description": "Schema for Rig diff review output.",
  "type": "object",
  "properties": {
    "diff_review_id": { "type": "string" },
    "workspace_id": { "type": "string" },
    "status": { "type": "string", "enum": ["pass", "warn", "fail", "skipped"] },
    "path_classifications": { "type": "object" },
    "authoritative": { "type": "boolean" }
  },
  "required": ["diff_review_id", "workspace_id", "status", "authoritative"]
}
