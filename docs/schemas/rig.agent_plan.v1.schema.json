{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rig Agent Plan",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "task",
    "agent_id",
    "mode",
    "prompt",
    "prompt_file",
    "allowed_paths",
    "forbidden_paths",
    "expected_outputs",
    "timeout_seconds",
    "requires_confirm",
    "git_mutation_allowed",
    "source_context",
    "created_by",
    "authoritative",
    "warnings"
  ],
  "properties": {
    "schema_version": {"const": "rig.agent_plan.v1"},
    "plan_id": {"type": "string"},
    "task": {"type": "string"},
    "agent_id": {"type": "string"},
    "mode": {"type": "string", "enum": ["read_only", "review", "implementation", "validation"]},
    "prompt": {"type": "string"},
    "prompt_file": {"type": "string"},
    "allowed_paths": {"type": "array", "items": {"type": "string"}},
    "forbidden_paths": {"type": "array", "items": {"type": "string"}},
    "expected_outputs": {"type": "array", "items": {"type": "string"}},
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "requires_confirm": {"type": "boolean"},
    "git_mutation_allowed": {"type": "boolean"},
    "source_context": {"type": "array", "items": {"type": "string"}},
    "created_by": {"type": "string"},
    "authoritative": {"type": "boolean", "const": false},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "plan_path": {"type": "string"},
    "plan_md_path": {"type": "string"}
  },
  "additionalProperties": true
}
