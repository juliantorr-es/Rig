  "authority_boundaries": [
    {
      "id": "forge-neutral-core",
      "description": "Rig core must not depend on any specific forge",
      "must_not": [
        "import forge-specific modules in core",
        "assume GitHub-only features",
        "require remote connectivity"
      ]
    },
    {
      "id": "adapter-isolation",
      "description": "Forge adapters must not leak provider-specific behavior into core",
      "must_not": [
        "modify core workflow based on adapter mode",
        "return forge-specific errors from core",
        "use forge APIs in core validation"
      ]
    },
    {
      "id": "local-first",
      "description": "Local-only mode must always work without any forge",
      "must_not": [
        "require forge API for promotion",
        "fail if remote unavailable",
        "assume remote branches exist"
      ]
    },
    {
      "id": "test-isolation",
      "description": "Tests must not depend on forge availability",
      "must_not": [
        "use real forge APIs in tests",
        "require network for tests",
        "test forge-specific behavior in core tests"
      ]
    },
    {
      "id": "git-substrate",
      "description": "Git is the canonical substrate",
      "must_not": [
        "replace git operations with forge APIs",
        "use forge APIs for local checks",
        "bypass git for remote operations"
      ]
    }
  ],
